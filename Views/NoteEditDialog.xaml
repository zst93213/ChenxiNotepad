<Window x:Class="BlindNotepad.NoteEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑日记" Height="620" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" MinHeight="560" MinWidth="500"
        FocusManager.FocusedElement="{Binding ElementName=titleBox}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="标题(_T):" Target="{Binding ElementName=titleBox}" AutomationProperties.Name="标题标签"/>
            <TextBox x:Name="titleBox" Width="380" AutomationProperties.Name="日记标题"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="分类(_C):" Target="{Binding ElementName=categoryBox}" AutomationProperties.Name="分类标签"/>
            <TextBox x:Name="categoryBox" Width="150" Text="默认" AutomationProperties.Name="日记分类"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="天气(_W):" Target="{Binding ElementName=weatherBox}" AutomationProperties.Name="天气标签"/>
            <ComboBox x:Name="weatherBox" IsEditable="True" Width="120" Margin="0,0,16,0"
                      AutomationProperties.Name="天气选择"/>
            <Label Content="心情(_M):" Target="{Binding ElementName=moodBox}" AutomationProperties.Name="心情标签"/>
            <ComboBox x:Name="moodBox" IsEditable="True" Width="120"
                      AutomationProperties.Name="心情选择"/>
        </StackPanel>
        <!-- 内容标签 + 字数统计 + 排版工具栏（同一行） -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
            <Label Content="内容(_N):" AutomationProperties.Name="内容标签"/>
            <TextBlock x:Name="charCountText" Text="共 0 字" Margin="12,0,0,0"
                       VerticalAlignment="Center" Opacity="0.7"
                       AutomationProperties.Name="字数统计"/>
            <Label Content="排版(_F):" Margin="24,0,4,0" Target="{Binding ElementName=formatPresetBox}" AutomationProperties.Name="排版预设标签"/>
            <ComboBox x:Name="formatPresetBox" Width="180" SelectedIndex="0"
                      AutomationProperties.Name="排版预设，选择排版方式"/>
            <Button x:Name="formatButton" Content="开始排版(_R)" Padding="10,4" Margin="6,0,0,0"
                    Click="OnFormatClick"
                    AutomationProperties.Name="开始排版按钮，应用选中的排版预设"/>
        </StackPanel>
        <TextBox Grid.Row="4" x:Name="contentBox" Margin="0,0,0,8"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="OnContentTextChanged"
                 AutomationProperties.Name="日记内容输入框"/>
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="okButton" Content="确定(_O)" Padding="20,4" Margin="0,0,8,0" Click="OnOk" AutomationProperties.Name="确定保存"/>
            <Button Content="取消(_C)" Padding="20,4" IsCancel="True" AutomationProperties.Name="取消"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock x:Name="hintText" Text="提示：内容不限字数，Ctrl+回车保存，Esc取消"
                       Opacity="0.5" FontSize="11"
                       AutomationProperties.Name="操作提示"/>
        </StackPanel>
    </Grid>
</Window>

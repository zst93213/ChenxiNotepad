<Window x:Class="BlindNotepad.FullRestorePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入主密码"
        Height="220" Width="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="全量恢复需要输入主密码来解密密码库数据："
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   AutomationProperties.Name="全量恢复密码提示"/>
        <PasswordBox x:Name="passwordBox" Margin="0,0,0,12"
                     KeyDown="PasswordBox_KeyDown"
                     AutomationProperties.Name="主密码输入框"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定(_O)" Padding="20,4" Margin="0,0,8,0"
                    Click="OnOk" AutomationProperties.Name="确认"/>
            <Button Content="取消(_C)" Padding="20,4"
                    Click="OnCancel" AutomationProperties.Name="取消"/>
        </StackPanel>
    </StackPanel>
</Window>

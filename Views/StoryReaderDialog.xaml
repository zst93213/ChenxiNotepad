<Window x:Class="BlindNotepad.StoryReaderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="话本阅读器" Height="800" Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinHeight="600" MinWidth="800"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- 标题栏 -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="书名:" Target="{Binding ElementName=titleBox}" AutomationProperties.Name="书名标签"/>
            <TextBox x:Name="titleBox" Width="300" IsReadOnly="True"
                     AutomationProperties.Name="书名"/>
            <Label Content="格式:" Margin="16,0,4,0" AutomationProperties.Name="格式标签"/>
            <TextBox x:Name="formatBox" Width="80" IsReadOnly="True"
                     AutomationProperties.Name="剧本格式"/>
            <Label Content="语速:" Margin="16,0,4,0" Target="{Binding ElementName=rateSlider}"
                   AutomationProperties.Name="语速标签"/>
            <Slider x:Name="rateSlider" Width="120" Minimum="-5" Maximum="5" Value="0"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="OnRateChanged"
                    AutomationProperties.Name="语速滑块，范围负5到5"/>
            <TextBlock x:Name="rateText" Text="0" VerticalAlignment="Center" Margin="4,0,0,0"
                       AutomationProperties.Name="当前语速值"/>
            <CheckBox x:Name="announceSpeakerCheckBox" Content="播报角色名" Margin="16,0,0,0"
                      VerticalAlignment="Center" IsChecked="True"
                      AutomationProperties.Name="是否在台词前播报角色名"/>
        </StackPanel>

        <!-- 分集导航 -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="prevChapterButton" Content="上一集(_P)" Padding="12,4" Margin="0,0,8,0"
                    Click="OnPrevChapter"
                    AutomationProperties.Name="上一集按钮"/>
            <ComboBox x:Name="chapterBox" Width="350"
                      SelectionChanged="OnChapterSelected"
                      AutomationProperties.Name="分集选择，下拉选择集数"/>
            <Button x:Name="nextChapterButton" Content="下一集(_N)" Padding="12,4" Margin="8,0,0,0"
                    Click="OnNextChapter"
                    AutomationProperties.Name="下一集按钮"/>
            <TextBlock x:Name="chapterInfoText" Text="" VerticalAlignment="Center" Margin="16,0,0,0"
                       AutomationProperties.Name="分集信息"/>
        </StackPanel>

        <!-- 正文显示 -->
        <TextBox Grid.Row="2" Grid.Column="0" x:Name="contentBox" Margin="0,0,4,8"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="16" Padding="8"
                 AutomationProperties.Name="正文内容，只读"/>

        <!-- 角色表侧栏 -->
        <Border Grid.Row="2" Grid.Column="1" Margin="4,0,0,8" Background="#0AFCB6C1" CornerRadius="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="角色表" FontSize="14" FontWeight="Bold"
                           Margin="10,8,10,4" AutomationProperties.Name="角色表标题"/>
                <TextBlock x:Name="characterCountText" DockPanel.Dock="Top" Text="" FontSize="11"
                           Opacity="0.6" Margin="10,0,10,8"
                           AutomationProperties.Name="角色数量"/>
                <ListBox x:Name="characterListBox" Background="Transparent" BorderThickness="0"
                         Margin="4,0,4,4"
                         AutomationProperties.Name="角色列表"/>
            </DockPanel>
        </Border>

        <!-- 当前朗读句子 + 说话人 -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#30FCE4EC" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="speakerNameText" Text="" FontWeight="Bold" Foreground="#D63384"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           AutomationProperties.Name="当前说话角色名"/>
                <TextBlock x:Name="currentSentenceText" Text="" TextWrapping="Wrap"
                           FontSize="14" Opacity="0.8" MaxWidth="800"
                           AutomationProperties.Name="当前正在朗读的句子"/>
            </StackPanel>
        </Border>

        <!-- 播放控制 -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Center">
            <Button x:Name="playButton" Content="播放(_S)" Padding="20,8" Margin="0,0,8,0"
                    Click="OnPlay"
                    AutomationProperties.Name="开始朗读按钮"/>
            <Button x:Name="pauseButton" Content="暂停(_P)" Padding="20,8" Margin="0,0,8,0"
                    Click="OnPause" IsEnabled="False"
                    AutomationProperties.Name="暂停朗读按钮"/>
            <Button x:Name="stopButton" Content="停止(_T)" Padding="20,8" Margin="0,0,8,0"
                    Click="OnStop" IsEnabled="False"
                    AutomationProperties.Name="停止朗读按钮"/>
            <Button x:Name="skipButton" Content="跳过本句(_K)" Padding="14,8" Margin="0,0,8,0"
                    Click="OnSkip" IsEnabled="False"
                    AutomationProperties.Name="跳过当前句子按钮"/>
            <Button x:Name="prevSentenceButton" Content="重读本集(_R)" Padding="14,8" Margin="0,0,8,0"
                    Click="OnReplayChapter" IsEnabled="False"
                    AutomationProperties.Name="重新朗读本集按钮"/>
        </StackPanel>

        <!-- 进度和提示 -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <TextBlock x:Name="progressText" Text="进度: 0%" VerticalAlignment="Center"
                       AutomationProperties.Name="阅读进度"/>
            <ProgressBar x:Name="progressBar" Width="300" Height="16" Margin="16,0,8,0"
                         Minimum="0" Maximum="100" Value="0"
                         AutomationProperties.Name="阅读进度条"/>
            <TextBlock x:Name="statusText" Text="" VerticalAlignment="Center" Margin="16,0,0,0"
                       Opacity="0.7"
                       AutomationProperties.Name="状态提示"/>
            <TextBlock Text="Space 播放/暂停 | ←/→ 上/下集 | Esc 关闭"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Opacity="0.5" FontSize="11" Margin="16,0,0,0"
                       AutomationProperties.Name="快捷键提示"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="BlindNotepad.ClipboardEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑剪贴板内容" Height="480" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" MinHeight="400" MinWidth="480"
        FocusManager.FocusedElement="{Binding ElementName=contentBox}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="内容(_N):" AutomationProperties.Name="内容标签"/>
            <TextBlock x:Name="charCountText" Text="0 字" Margin="12,0,0,0"
                       VerticalAlignment="Center" Opacity="0.7"
                       AutomationProperties.Name="字数统计"/>
        </StackPanel>
        <TextBox Grid.Row="1" x:Name="contentBox" Margin="0,0,0,8"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 MaxLength="10000"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="OnContentTextChanged"
                 AutomationProperties.Name="剪贴板内容编辑框"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="okButton" Content="确定并复制(_O)" Padding="20,4" Margin="0,0,8,0"
                    Click="OnOk" AutomationProperties.Name="确定保存并复制到剪贴板"/>
            <Button Content="取消(_C)" Padding="20,4" IsCancel="True" AutomationProperties.Name="取消"/>
        </StackPanel>
    </Grid>
</Window>

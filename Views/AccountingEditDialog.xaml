<Window x:Class="BlindNotepad.AccountingEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑记账" Height="480" Width="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=titleBox}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 类型选择 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="类型(_T):" AutomationProperties.Name="类型标签"/>
            <RadioButton x:Name="expenseRadio" Content="支出" GroupName="AccType" IsChecked="True"
                         Margin="16,0,0,0" Checked="OnTypeChanged"
                         AutomationProperties.Name="支出"/>
            <RadioButton x:Name="incomeRadio" Content="收入" GroupName="AccType"
                         Margin="16,0,0,0" Checked="OnTypeChanged"
                         AutomationProperties.Name="收入"/>
        </StackPanel>

        <!-- 说明 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="说明(_D):" Target="{Binding ElementName=titleBox}" AutomationProperties.Name="说明"/>
            <TextBox x:Name="titleBox" Width="300" AutomationProperties.Name="说明"/>
        </StackPanel>

        <!-- 金额 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="金额(_A):" Target="{Binding ElementName=amountBox}" AutomationProperties.Name="金额"/>
            <TextBox x:Name="amountBox" Width="150" PreviewTextInput="OnAmountPreviewInput"
                     AutomationProperties.Name="金额"/>
            <Label Content="元" Margin="4,0,0,0" AutomationProperties.Name="元"/>
        </StackPanel>

        <!-- 分类 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="分类(_C):" Target="{Binding ElementName=categoryBox}" AutomationProperties.Name="分类"/>
            <ComboBox x:Name="categoryBox" IsEditable="True" Width="200"
                      AutomationProperties.Name="分类"/>
        </StackPanel>

        <!-- 支付方式 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="支付方式(_P):" Target="{Binding ElementName=paymentMethodBox}" AutomationProperties.Name="支付方式"/>
            <ComboBox x:Name="paymentMethodBox" IsEditable="True" Width="160"
                      AutomationProperties.Name="支付方式"/>
        </StackPanel>

        <!-- 日期 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="日期(_E):" Target="{Binding ElementName=datePicker}" AutomationProperties.Name="日期"/>
            <DatePicker x:Name="datePicker" Width="150"
                        AutomationProperties.Name="日期"/>
        </StackPanel>

        <!-- 备注 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,4">
            <Label Content="备注(_N):" AutomationProperties.Name="备注"/>
        </StackPanel>
        <TextBox Grid.Row="6" x:Name="noteBox" Margin="0,24,0,8"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="备注"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="okButton" Content="确定(_O)" Padding="20,4" Margin="0,0,8,0" Click="OnOk" AutomationProperties.Name="确定保存"/>
            <Button Content="取消(_C)" Padding="20,4" IsCancel="True" AutomationProperties.Name="取消"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="BlindNotepad.SnippetEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑笔记" Height="580" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" MinHeight="520" MinWidth="500"
        FocusManager.FocusedElement="{Binding ElementName=titleBox}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="标题(_T):" Target="{Binding ElementName=titleBox}" AutomationProperties.Name="标题标签"/>
            <TextBox x:Name="titleBox" Width="380" AutomationProperties.Name="笔记标题"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="分类(_C):" Target="{Binding ElementName=categoryBox}" AutomationProperties.Name="分类标签"/>
            <ComboBox x:Name="categoryBox" IsEditable="True" Width="200" AutomationProperties.Name="笔记分类，可选择或输入"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <Label Content="内容(_N):" AutomationProperties.Name="内容标签"/>
            <TextBlock x:Name="charCountText" Text="0 / 10000" Margin="12,0,0,0"
                       VerticalAlignment="Center" Opacity="0.7"
                       AutomationProperties.Name="字数统计"/>
        </StackPanel>
        <TextBox Grid.Row="3" x:Name="contentBox" Margin="0,0,0,4"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 MaxLength="10000"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="OnContentTextChanged"
                 AutomationProperties.Name="笔记内容，最多10000字"/>
        <!-- 排版工具栏 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,8">
            <Label Content="排版(_F):" Target="{Binding ElementName=formatPresetBox}" AutomationProperties.Name="排版预设标签"/>
            <ComboBox x:Name="formatPresetBox" Width="200" SelectedIndex="0"
                      AutomationProperties.Name="排版预设，选择排版方式"/>
            <Button x:Name="formatButton" Content="开始排版(_R)" Padding="12,4" Margin="8,0,0,0"
                    Click="OnFormatClick"
                    AutomationProperties.Name="开始排版按钮，应用选中的排版预设"/>
        </StackPanel>
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="okButton" Content="确定(_O)" Padding="20,4" Margin="0,0,8,0" Click="OnOk" AutomationProperties.Name="确定保存"/>
            <Button Content="取消(_C)" Padding="20,4" IsCancel="True" AutomationProperties.Name="取消"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="BlindNotepad.PasswordEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑密码"
        Height="680" Width="600"
        MinHeight="560" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        FocusManager.FocusedElement="{Binding ElementName=titleBox}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>

                <!-- 基础信息 -->
                <GroupBox Header="基础信息" Padding="8" Margin="0,0,0,8"
                          AutomationProperties.Name="基础信息分组">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="平台名称(_T):" Target="{Binding ElementName=titleBox}"
                               AutomationProperties.Name="平台名称"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="titleBox" Margin="0,4"
                                 AutomationProperties.Name="平台名称"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="用户名(_U):" Target="{Binding ElementName=userNameBox}"
                               AutomationProperties.Name="用户名"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="userNameBox" Margin="0,4"
                                 AutomationProperties.Name="用户名"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="密码(_P):" Target="{Binding ElementName=passwordBox}"
                               AutomationProperties.Name="密码"/>
                        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="passwordBox" Margin="0,4"
                                     AutomationProperties.Name="密码"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="生成(_G)" Margin="8,4,0,4" Padding="10,2"
                                Click="OnGeneratePassword"
                                AutomationProperties.Name="生成密码"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="网址(_R):" Target="{Binding ElementName=urlBox}"
                               AutomationProperties.Name="网址"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="urlBox" Margin="0,4"
                                 AutomationProperties.Name="网址"/>
                    </Grid>
                </GroupBox>

                <!-- 安全辅助 -->
                <GroupBox Header="安全辅助" Padding="8" Margin="0,0,0,8"
                          AutomationProperties.Name="安全辅助分组">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="预留手机号(_H):" Target="{Binding ElementName=phoneBox}"
                               AutomationProperties.Name="预留手机号"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="phoneBox" Margin="0,4"
                                 AutomationProperties.Name="预留手机号"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="预留邮箱(_E):" Target="{Binding ElementName=emailBox}"
                               AutomationProperties.Name="预留邮箱"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="emailBox" Margin="0,4"
                                 AutomationProperties.Name="预留邮箱"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="TOTP 密钥(_K):" Target="{Binding ElementName=totpBox}"
                               AutomationProperties.Name="TOTP 密钥"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="totpBox" Margin="0,4"
                                 AutomationProperties.Name="TOTP 密钥"/>
                    </Grid>
                </GroupBox>

                <!-- 密保问题 -->
                <GroupBox Header="密保问题" Padding="8" Margin="0,0,0,8"
                          AutomationProperties.Name="密保问题分组">
                    <StackPanel>
                        <TextBlock Text="可添加多组密保问题，答案以密码框录入。" Opacity="0.7" Margin="0,0,0,6"
                                   AutomationProperties.Name="密保问题说明"/>
                        <StackPanel x:Name="securityQuestionsPanel"/>
                        <Button Content="添加密保问题(_Q)" Padding="10,4" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Click="OnAddSecurityQuestion"
                                AutomationProperties.Name="添加一组密保问题"/>
                    </StackPanel>
                </GroupBox>

                <!-- 自定义字段 -->
                <GroupBox Header="自定义字段" Padding="8" Margin="0,0,0,8"
                          AutomationProperties.Name="自定义字段分组">
                    <StackPanel>
                        <TextBlock Text="可添加多组自定义字段；勾选“敏感”后复制时显示为已隐藏。" Opacity="0.7" Margin="0,0,0,6"
                                   AutomationProperties.Name="自定义字段说明"/>
                        <StackPanel x:Name="customFieldsPanel"/>
                        <Button Content="添加自定义字段(_F)" Padding="10,4" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Click="OnAddCustomField"
                                AutomationProperties.Name="添加一组自定义字段"/>
                    </StackPanel>
                </GroupBox>

                <!-- 其他 -->
                <GroupBox Header="其他" Padding="8" Margin="0,0,0,8"
                          AutomationProperties.Name="其他分组">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="标签(_G):" Target="{Binding ElementName=tagsBox}"
                               AutomationProperties.Name="标签"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="tagsBox" Margin="0,4"
                                 AutomationProperties.Name="标签"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="备注(_R):" Target="{Binding ElementName=notesBox}"
                               AutomationProperties.Name="备注"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="notesBox" Margin="0,4"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="备注"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="okButton" Content="确定(_O)" Padding="20,4" Margin="0,0,8,0"
                    Click="OnOk" AutomationProperties.Name="确定保存"/>
            <Button Content="取消(_C)" Padding="20,4" IsCancel="True"
                    AutomationProperties.Name="取消"/>
        </StackPanel>
    </Grid>
</Window>

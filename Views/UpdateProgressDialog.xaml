<Window x:Class="BlindNotepad.UpdateProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在更新" Height="220" Width="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=cancelButton}">
    <DockPanel Margin="16">
        <!-- 状态文本 -->
        <TextBlock x:Name="statusText" Text="准备下载..." DockPanel.Dock="Top"
                   FontSize="14" Margin="0,0,0,12"
                   AutomationProperties.Name="更新状态"/>
        <!-- 进度百分比 -->
        <TextBlock x:Name="percentText" Text="" DockPanel.Dock="Top"
                   FontSize="13" Margin="0,0,0,8"
                   AutomationProperties.Name="下载进度百分比"/>
        <!-- 进度条 -->
        <ProgressBar x:Name="progressBar" DockPanel.Dock="Top"
                     Height="24" Minimum="0" Maximum="100" Value="0"
                     AutomationProperties.Name="下载进度条"/>
        <!-- 下载大小信息 -->
        <TextBlock x:Name="sizeText" Text="" DockPanel.Dock="Top"
                   FontSize="12" Opacity="0.7" Margin="0,8,0,0"
                   AutomationProperties.Name="已下载大小"/>
        <!-- 取消按钮 -->
        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="cancelButton" Content="取消更新(_C)" Padding="16,6"
                    Click="OnCancel" AutomationProperties.Name="取消更新"/>
        </StackPanel>
    </DockPanel>
</Window>

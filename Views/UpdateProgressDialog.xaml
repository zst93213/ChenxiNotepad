<Window x:Class="BlindNotepad.UpdateProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自动更新" Height="280" Width="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=cancelButton}">
    <DockPanel Margin="16">
        <!-- 阶段标题 -->
        <TextBlock x:Name="stageText" Text="正在检查更新..." DockPanel.Dock="Top"
                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="更新阶段"/>
        <!-- 状态文本（详细信息） -->
        <TextBlock x:Name="statusText" Text="" DockPanel.Dock="Top"
                   FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="更新状态"/>
        <!-- 进度百分比 -->
        <TextBlock x:Name="percentText" Text="" DockPanel.Dock="Top"
                   FontSize="13" Margin="0,0,0,4"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="下载进度百分比"/>
        <!-- 进度条 -->
        <ProgressBar x:Name="progressBar" DockPanel.Dock="Top"
                     Height="24" Minimum="0" Maximum="100" Value="0"
                     AutomationProperties.Name="下载进度条"/>
        <!-- 下载大小信息 -->
        <TextBlock x:Name="sizeText" Text="" DockPanel.Dock="Top"
                   FontSize="12" Opacity="0.7" Margin="0,6,0,0"
                   AutomationProperties.Name="已下载大小"/>
        <!-- 速度+剩余时间 -->
        <TextBlock x:Name="speedText" Text="" DockPanel.Dock="Top"
                   FontSize="12" Opacity="0.7" Margin="0,2,0,0"
                   AutomationProperties.Name="下载速度"/>
        <!-- 按钮区 -->
        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="cancelButton" Content="取消(_C)" Padding="16,6"
                    Click="OnCancel" AutomationProperties.Name="取消更新"/>
        </StackPanel>
    </DockPanel>
</Window>

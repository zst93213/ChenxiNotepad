<Window x:Class="BlindNotepad.UrlFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择文件夹"
        Height="480" Width="460"
        MinHeight="360" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        FocusManager.FocusedElement="{Binding ElementName=folderList}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <DockPanel Margin="12">
        <TextBlock x:Name="hintText" DockPanel.Dock="Top" Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Text="上下光标选择已有文件夹，或直接输入新文件夹名（可用 / 表示层级，如 导入/学习）。回车确认，Esc 取消。"
                   AutomationProperties.Name="文件夹选择说明"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="newButton" Content="新建并选中(_N)" Padding="14,4" Margin="0,0,8,0"
                    Click="OnNew" AutomationProperties.Name="新建并选中该文件夹"/>
            <Button Content="确定(_O)" Padding="20,4" Margin="0,0,8,0"
                    Click="OnOk" AutomationProperties.Name="确认选择文件夹"/>
            <Button Content="取消(_C)" Padding="20,4" IsCancel="True"
                    AutomationProperties.Name="取消选择文件夹"/>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListBox x:Name="folderList" Grid.Row="0"
                     SelectionChanged="folderList_SelectionChanged"
                     AutomationProperties.Name="已有文件夹列表"/>
            <TextBlock Grid.Row="1" Margin="0,8,4,2" Text="文件夹名："
                        AutomationProperties.Name="文件夹名标签"/>
            <TextBox x:Name="folderPathBox" Grid.Row="2"
                     AutomationProperties.Name="文件夹名输入框"/>
        </Grid>
    </DockPanel>
</Window>

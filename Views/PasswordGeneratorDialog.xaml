<Window x:Class="BlindNotepad.PasswordGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码生成器"
        Height="440" Width="480"
        MinHeight="400" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        FocusManager.FocusedElement="{Binding ElementName=generateButton}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 长度 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="长度(_L):" Target="{Binding ElementName=lengthSlider}"
                   AutomationProperties.Name="密码长度"/>
            <Slider x:Name="lengthSlider" Minimum="8" Maximum="40" Value="20"
                    Width="240" TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="OnLengthChanged"
                    AutomationProperties.Name="密码长度滑块，8 到 40"/>
            <TextBlock x:Name="lengthValueText" Text="20" Width="40"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       AutomationProperties.Name="当前密码长度"/>
        </StackPanel>

        <!-- 选项 -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <CheckBox x:Name="upperCheck" Content="大写字母(_U)" IsChecked="True" Margin="0,0,12,4"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                      AutomationProperties.Name="包含大写字母"/>
            <CheckBox x:Name="lowerCheck" Content="小写字母(_W)" IsChecked="True" Margin="0,0,12,4"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                      AutomationProperties.Name="包含小写字母"/>
            <CheckBox x:Name="digitCheck" Content="数字(_D)" IsChecked="True" Margin="0,0,12,4"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                      AutomationProperties.Name="包含数字"/>
            <CheckBox x:Name="symbolCheck" Content="符号(_S)" IsChecked="True" Margin="0,0,12,4"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                      AutomationProperties.Name="包含符号"/>
            <CheckBox x:Name="readableCheck" Content="易读模式(_R)" Margin="0,0,12,4"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                      AutomationProperties.Name="易读模式，排除易混淆字符"/>
        </WrapPanel>

        <!-- 生成按钮 -->
        <Button Grid.Row="2" x:Name="generateButton" Content="生成(_G)"
                Padding="20,4" HorizontalAlignment="Left" Margin="0,0,0,10"
                Click="OnGenerate"
                AutomationProperties.Name="生成密码"/>

        <!-- 结果（默认用 PasswordBox 掩码显示，可临时查看明文） -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <PasswordBox Grid.Column="0" x:Name="resultBox"
                         AutomationProperties.Name="生成的密码，默认掩码显示"/>
            <TextBox Grid.Column="0" x:Name="revealBox" IsReadOnly="True" Visibility="Collapsed"
                     AutomationProperties.Name="生成的密码明文"/>
            <Button Grid.Column="1" x:Name="revealButton" Content="显示(_H)"
                    Margin="8,0,0,0" Padding="12,4" Click="OnReveal"
                    AutomationProperties.Name="临时查看密码明文"/>
        </Grid>

        <!-- 强度 -->
        <TextBlock Grid.Row="4" x:Name="strengthText" Text="强度：—"
                   FontWeight="Bold" Margin="0,0,0,10"
                   AutomationProperties.Name="密码强度"/>

        <TextBlock Grid.Row="5" TextWrapping="Wrap" Opacity="0.7"
                   Text="说明：默认掩码显示生成结果，可按“显示”临时查看 5 秒。确定后将填入或复制该密码。"
                   AutomationProperties.Name="生成器说明"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="okButton" Content="确定(_O)" Padding="20,4" Margin="0,0,8,0"
                    Click="OnOk" AutomationProperties.Name="确定使用该密码"/>
            <Button Content="取消(_C)" Padding="20,4" IsCancel="True"
                    AutomationProperties.Name="取消"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="BlindNotepad.ChangeMasterPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改主密码" Height="300" Width="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" MinHeight="280" MinWidth="400"
        FocusManager.FocusedElement="{Binding ElementName=oldPasswordBox}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <Label Content="当前主密码(_O):" Target="{Binding ElementName=oldPasswordBox}" AutomationProperties.Name="当前主密码标签"/>
            <PasswordBox x:Name="oldPasswordBox" AutomationProperties.Name="当前主密码输入框"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Label Content="新主密码(_N):" Target="{Binding ElementName=newPasswordBox}" AutomationProperties.Name="新主密码标签"/>
            <PasswordBox x:Name="newPasswordBox" AutomationProperties.Name="新主密码输入框"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <Label Content="确认新主密码(_C):" Target="{Binding ElementName=confirmPasswordBox}" AutomationProperties.Name="确认新主密码标签"/>
            <PasswordBox x:Name="confirmPasswordBox" AutomationProperties.Name="确认新主密码输入框"/>
        </StackPanel>
        <TextBlock Grid.Row="3" x:Name="hintText" TextWrapping="Wrap" Opacity="0.7"
                   Text="主密码至少 6 位，修改后需用新密码解锁。主密码无法找回，请妥善保管。"
                   AutomationProperties.Name="提示"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="okButton" Content="确定(_O)" Padding="20,4" Margin="0,0,8,0" Click="OnOk" AutomationProperties.Name="确认修改主密码"/>
            <Button Content="取消(_C)" Padding="20,4" IsCancel="True" AutomationProperties.Name="取消"/>
        </StackPanel>
    </Grid>
</Window>

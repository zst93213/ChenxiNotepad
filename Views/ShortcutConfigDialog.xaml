<Window x:Class="BlindNotepad.ShortcutConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键设置" Height="520" Width="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" MinHeight="460" MinWidth="560"
        FocusManager.FocusedElement="{Binding ElementName=shortcutList}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.7"
                   Text="选择一个操作，在输入框中按下新的快捷键组合，点击应用。支持导出/导入配置。"
                   AutomationProperties.Name="说明"/>
        <DockPanel Grid.Row="1" LastChildFill="True">
            <Grid DockPanel.Dock="Right" Width="240" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="当前快捷键：" AutomationProperties.Name="当前快捷键标签"/>
                <TextBox Grid.Row="1" x:Name="gestureBox" Margin="0,0,0,8" IsReadOnly="True" AutomationProperties.Name="快捷键显示框"/>
                <Button Grid.Row="2" x:Name="applyButton" Content="应用新快捷键(_A)" Padding="12,4" Click="OnApply" AutomationProperties.Name="应用新快捷键"/>
            </Grid>
            <ListBox x:Name="shortcutList" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="快捷键列表"/>
        </DockPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="导出配置(_E)" Padding="12,4" Margin="0,0,8,0" Click="OnExport" AutomationProperties.Name="导出快捷键配置"/>
            <Button Content="导入配置(_I)" Padding="12,4" Margin="0,0,8,0" Click="OnImport" AutomationProperties.Name="导入快捷键配置"/>
            <Button Content="重置默认(_R)" Padding="12,4" Click="OnReset" AutomationProperties.Name="重置为默认快捷键"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="okButton" Content="确定(_O)" Padding="20,4" Margin="0,0,8,0" Click="OnOk" AutomationProperties.Name="确定保存"/>
            <Button Content="取消(_C)" Padding="20,4" IsCancel="True" AutomationProperties.Name="取消"/>
        </StackPanel>
    </Grid>
</Window>

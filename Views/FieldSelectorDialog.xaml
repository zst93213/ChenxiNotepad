<Window x:Class="BlindNotepad.FieldSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="复制字段选择器"
        Height="440" Width="440"
        MinHeight="320" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        FocusManager.FocusedElement="{Binding ElementName=fieldListBox}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Text="上下光标选择字段，回车复制，Esc 关闭。敏感字段显示为“已隐藏”，复制后仍会自动清除。"
                   AutomationProperties.Name="字段选择器说明"/>
        <Button DockPanel.Dock="Bottom" Content="关闭(_C)" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,8,0,0" Padding="20,4"
                AutomationProperties.Name="关闭字段选择器"/>
        <ListBox x:Name="fieldListBox"
                 AutomationProperties.Name="可复制字段列表"/>
    </DockPanel>
</Window>

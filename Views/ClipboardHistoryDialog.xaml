<Window x:Class="BlindNotepad.ClipboardHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板历史" Height="520" Width="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        ResizeMode="CanResize" MinHeight="400" MinWidth="400"
        FocusManager.FocusedElement="{Binding ElementName=historyList}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6"
                   Text="↑↓ 选择  Enter 复制到剪贴板  Del 删除  Esc 关闭"
                   Opacity="0.7" AutomationProperties.Name="操作提示"/>
        <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="searchBox" Grid.Column="0" Margin="0,0,8,0"
                     TextChanged="OnSearchChanged"
                     AutomationProperties.Name="搜索剪贴板历史"/>
            <Button x:Name="clearButton" Grid.Column="1" Content="清空全部(_C)" Padding="10,4" Margin="0,0,8,0"
                    Click="OnClearAll" AutomationProperties.Name="清空所有非置顶历史"/>
            <Button x:Name="closeButton" Grid.Column="2" Content="关闭(_X)" Padding="10,4" IsCancel="True"
                    AutomationProperties.Name="关闭窗口"/>
        </Grid>
        <ListBox x:Name="historyList" Margin="0,0,0,0"
                 SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnItemDoubleClick"
                 AutomationProperties.Name="剪贴板历史列表"/>
    </DockPanel>
</Window>

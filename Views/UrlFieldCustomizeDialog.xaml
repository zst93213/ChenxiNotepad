<Window x:Class="BlindNotepad.UrlFieldCustomizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义字段显示"
        Height="520" Width="600"
        MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="点击每个字段右侧的「隐藏」按钮可以隐藏该字段（隐藏后在详情区不显示，除非点击底部的「显示所有字段」按钮）。"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      x:Name="rootScroll">
            <StackPanel x:Name="fieldsPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="resetAllBtn" Content="全部显示(_R)" Padding="16,4" Margin="0,0,8,0"
                    Click="OnResetAll" AutomationProperties.Name="全部显示按钮"/>
            <Button Content="关闭(_C)" Padding="20,4" IsCancel="True"
                    AutomationProperties.Name="关闭"/>
        </StackPanel>
    </Grid>
</Window>

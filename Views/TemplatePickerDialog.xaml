<Window x:Class="BlindNotepad.TemplatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择模板"
        Height="440" Width="460"
        MinHeight="320" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        FocusManager.FocusedElement="{Binding ElementName=templateList}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Text="上下光标选择模板，回车确认，Esc 取消。"
                   AutomationProperties.Name="模板选择说明"/>
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="确定(_O)" Padding="20,4" Margin="0,0,8,0"
                    Click="OnOkClick" AutomationProperties.Name="确认选择模板"/>
            <Button Grid.Column="2" Content="取消(_C)" Padding="20,4"
                    Click="OnCancelClick" AutomationProperties.Name="取消选择模板"/>
        </Grid>
        <ListBox x:Name="templateList"
                 SelectionChanged="OnSelectionChanged"
                 AutomationProperties.Name="模板列表"/>
    </DockPanel>
</Window>

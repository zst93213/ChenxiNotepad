<Window x:Class="BlindNotepad.UrlEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑网址"
        Height="480" Width="500"
        MinHeight="420" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        FocusManager.FocusedElement="{Binding ElementName=titleBox}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="站点名称(_N):" Target="{Binding ElementName=titleBox}"
               AutomationProperties.Name="站点名称"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="titleBox" Margin="0,4"
                 AutomationProperties.Name="站点名称"/>

        <Label Grid.Row="1" Grid.Column="0" Content="网址(_U):" Target="{Binding ElementName=urlBox}"
               AutomationProperties.Name="网址"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="urlBox" Margin="0,4"
                 AutomationProperties.Name="网址"/>

        <Label Grid.Row="2" Grid.Column="0" Content="账号(_A):" Target="{Binding ElementName=accountBox}"
               AutomationProperties.Name="账号"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="accountBox" Margin="0,4"
                 AutomationProperties.Name="账号"/>

        <Label Grid.Row="3" Grid.Column="0" Content="分类(_C):" Target="{Binding ElementName=categoryBox}"
               AutomationProperties.Name="分类"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="categoryBox" IsEditable="True" Margin="0,4"
                  AutomationProperties.Name="分类"/>

        <Label Grid.Row="4" Grid.Column="0" Content="关联密码(_L):" Target="{Binding ElementName=linkedPasswordBox}"
               AutomationProperties.Name="关联密码"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="linkedPasswordBox" Margin="0,4"
                  AutomationProperties.Name="关联密码"/>

        <Label Grid.Row="5" Grid.Column="0" Content="备注(_R):" Target="{Binding ElementName=notesBox}"
               AutomationProperties.Name="备注"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="notesBox" Margin="0,4"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="备注"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="okButton" Content="确定(_O)" Padding="20,4" Margin="0,0,8,0"
                    Click="OnOk" AutomationProperties.Name="确定保存"/>
            <Button Content="取消(_C)" Padding="20,4" IsCancel="True"
                    AutomationProperties.Name="取消"/>
        </StackPanel>
    </Grid>
</Window>

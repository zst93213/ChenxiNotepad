<Window x:Class="BlindNotepad.UrlEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑网址"
        Height="560" Width="560"
        MinHeight="480" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        FocusManager.FocusedElement="{Binding ElementName=titleBox}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 滚动区：字段太多时可以滚动 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" x:Name="rootScroll">
            <StackPanel>
                <!-- 站点名称 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="站点名称(_N):" Target="{Binding ElementName=titleBox}"
                           AutomationProperties.Name="站点名称"/>
                    <TextBox Grid.Column="1" x:Name="titleBox" Margin="0,4"
                             AutomationProperties.Name="站点名称"/>
                </Grid>

                <!-- 网址 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="网址(_U):" Target="{Binding ElementName=urlBox}"
                           AutomationProperties.Name="网址"/>
                    <TextBox Grid.Column="1" x:Name="urlBox" Margin="0,4"
                             AutomationProperties.Name="网址"/>
                </Grid>

                <!-- 账号密码区域（动态生成） -->
                <GroupBox Header="账号密码（支持多个）" Margin="0,4,0,6">
                    <StackPanel>
                        <StackPanel x:Name="accountsPanel" Margin="4"/>
                        <Button Content="+ 添加账号(_O)" HorizontalAlignment="Left" Margin="4,2,4,6" Padding="14,3"
                                Click="OnAddAccount" AutomationProperties.Name="添加账号"/>
                    </StackPanel>
                </GroupBox>

                <!-- 密钥区域（动态生成） -->
                <GroupBox Header="密钥 / API Key（支持多个）" Margin="0,4,0,6">
                    <StackPanel>
                        <StackPanel x:Name="secretsPanel" Margin="4"/>
                        <Button Content="+ 添加密钥(_K)" HorizontalAlignment="Left" Margin="4,2,4,6" Padding="14,3"
                                Click="OnAddSecret" AutomationProperties.Name="添加密钥"/>
                    </StackPanel>
                </GroupBox>

                <!-- 分类 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="分类(_C):" Target="{Binding ElementName=categoryBox}"
                           AutomationProperties.Name="分类"/>
                    <ComboBox Grid.Column="1" x:Name="categoryBox" IsEditable="True" Margin="0,4"
                              AutomationProperties.Name="分类"/>
                </Grid>

                <!-- 关联密码 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="关联密码(_L):" Target="{Binding ElementName=linkedPasswordBox}"
                           AutomationProperties.Name="关联密码"/>
                    <ComboBox Grid.Column="1" x:Name="linkedPasswordBox" Margin="0,4"
                              AutomationProperties.Name="关联密码"/>
                </Grid>

                <!-- 备注 -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="备注(_R):" Target="{Binding ElementName=notesBox}"
                           AutomationProperties.Name="备注"/>
                    <TextBox Grid.Column="1" x:Name="notesBox" Margin="0,4" Height="100"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="备注"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部确定/取消 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="okButton" Content="确定(_O)" Padding="20,4" Margin="0,0,8,0"
                    Click="OnOk" AutomationProperties.Name="确定保存"/>
            <Button Content="取消(_C)" Padding="20,4" IsCancel="True"
                    AutomationProperties.Name="取消"/>
        </StackPanel>
    </Grid>
</Window>

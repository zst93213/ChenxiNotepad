<Window x:Class="BlindNotepad.FindReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查找替换" Height="400" Width="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" MinHeight="360" MinWidth="400"
        FocusManager.FocusedElement="{Binding ElementName=findBox}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 查找 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Label Content="查找(_F):" Target="{Binding ElementName=findBox}" AutomationProperties.Name="查找标签"/>
            <TextBox x:Name="findBox" Width="280" AutomationProperties.Name="查找内容输入框"/>
        </StackPanel>

        <!-- 替换 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Label Content="替换(_R):" Target="{Binding ElementName=replaceBox}" AutomationProperties.Name="替换标签"/>
            <TextBox x:Name="replaceBox" Width="280" AutomationProperties.Name="替换内容输入框"/>
        </StackPanel>

        <!-- 选项 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="caseSensitive" Content="区分大小写(_C)" Margin="0,0,16,0"
                      AutomationProperties.Name="区分大小写复选框"/>
            <CheckBox x:Name="useRegex" Content="正则表达式(_E)"
                      AutomationProperties.Name="正则表达式复选框"/>
        </StackPanel>

        <!-- 查找按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="findNextButton" Content="查找下一个(_N)" Padding="12,4" Margin="0,0,8,0"
                    Click="OnFindNext" AutomationProperties.Name="查找下一个按钮"/>
            <Button x:Name="findPrevButton" Content="查找上一个(_P)" Padding="12,4" Margin="0,0,8,0"
                    Click="OnFindPrev" AutomationProperties.Name="查找上一个按钮"/>
            <Button x:Name="replaceButton" Content="替换(_R)" Padding="12,4" Margin="0,0,8,0"
                    Click="OnReplace" AutomationProperties.Name="替换按钮"/>
            <Button x:Name="replaceAllButton" Content="全部替换(_A)" Padding="12,4"
                    Click="OnReplaceAll" AutomationProperties.Name="全部替换按钮"/>
        </StackPanel>

        <!-- 分隔线 -->
        <Separator Grid.Row="4" Margin="0,4,0,4"/>

        <!-- 朗读工具栏 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,4,0,6">
            <Button x:Name="speakButton" Content="朗读(_S)" Padding="12,4" Margin="0,0,8,0"
                    Click="OnSpeak" AutomationProperties.Name="朗读按钮，朗读选中的文本"/>
            <Button x:Name="stopSpeakButton" Content="停止朗读(_T)" Padding="12,4" Margin="0,0,8,0"
                    Click="OnStopSpeak" AutomationProperties.Name="停止朗读按钮"/>
            <Label Content="语速:" AutomationProperties.Name="语速标签"/>
            <Slider x:Name="rateSlider" Width="120" Minimum="-5" Maximum="5" Value="0"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    AutomationProperties.Name="朗读语速滑块，范围负5到正5"/>
            <TextBlock x:Name="rateText" Text="0" VerticalAlignment="Center" Margin="4,0,0,0"
                       AutomationProperties.Name="当前语速值"/>
        </StackPanel>

        <!-- 语音输入 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="voiceInputButton" Content="语音输入(_V)" Padding="12,4" Margin="0,0,8,0"
                    Click="OnVoiceInput" AutomationProperties.Name="语音输入按钮，开始语音识别"/>
            <TextBlock x:Name="statusText" Text="" VerticalAlignment="Center" Opacity="0.7"
                       AutomationProperties.Name="状态提示"/>
        </StackPanel>
    </Grid>
</Window>

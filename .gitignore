.nuget/

# ===== IDE / 编辑器 =====
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.cache

# ===== 操作系统文件 =====
Thumbs.db
Desktop.ini
.DS_Store

# ===== 发布包 =====
*.zip
*.7z
*.tar.gz

# ===== 日志和临时文件 =====
*.log
*.tmp
*.bak

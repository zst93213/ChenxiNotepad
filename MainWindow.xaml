<Window x:Class="BlindNotepad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlindNotepad 盲人记事本"
        Height="720" Width="1040"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=urlListBox}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <DockPanel>
        <!-- 顶部菜单栏 -->
        <Menu DockPanel.Dock="Top" AutomationProperties.Name="主菜单">
            <MenuItem Header="文件(_F)" AutomationProperties.Name="文件菜单">
                <MenuItem Header="新建(_N)" InputGestureText="Ctrl+N" Click="OnNew" AutomationProperties.Name="新建条目"/>
                <MenuItem Header="保存(_S)" InputGestureText="Ctrl+S" Click="OnSave" AutomationProperties.Name="保存"/>
                <Separator/>
                <MenuItem Header="全量备份(_A)" InputGestureText="Ctrl+Shift+A" Click="OnFullBackup" AutomationProperties.Name="全量备份所有数据"/>
                <MenuItem Header="全量恢复(_R)" InputGestureText="Ctrl+Shift+R" Click="OnFullRestore" AutomationProperties.Name="从全量备份恢复"/>
                <Separator/>
                <MenuItem Header="导入数据(_I)" Click="OnImport" AutomationProperties.Name="导入书签或密码"/>
                <MenuItem Header="导出备份(_B)" Click="OnBackup" AutomationProperties.Name="导出加密备份"/>
                <MenuItem Header="从备份恢复(_E)" Click="OnRestore" AutomationProperties.Name="从备份恢复数据"/>
                <Separator/>
                <MenuItem Header="修改主密码(_M)" Click="OnChangeMasterPassword" AutomationProperties.Name="修改主密码"/>
                <MenuItem Header="设置(_T)" Click="OnSettings" AutomationProperties.Name="应用设置"/>
                <Separator/>
                <MenuItem Header="退出(_X)" Click="OnExit" AutomationProperties.Name="退出程序"/>
            </MenuItem>
            <MenuItem Header="编辑(_E)" AutomationProperties.Name="编辑菜单">
                <MenuItem Header="编辑(_E)" InputGestureText="Ctrl+E / F2" Click="OnEdit" AutomationProperties.Name="编辑条目"/>
                <MenuItem Header="删除(_D)" InputGestureText="Ctrl+D / Del" Click="OnDelete" AutomationProperties.Name="删除条目"/>
                <MenuItem Header="搜索(_R)" InputGestureText="Ctrl+F" Click="OnSearch" AutomationProperties.Name="搜索"/>
                <Separator/>
                <MenuItem Header="切换收藏(_V)" InputGestureText="Ctrl+Shift+F" Click="OnToggleFavorite" AutomationProperties.Name="切换收藏置顶"/>
                <MenuItem Header="批量删除(_A)" Click="OnBatchDelete" AutomationProperties.Name="批量删除选中项"/>
                <MenuItem Header="批量移动分类(_G)" Click="OnBatchMoveCategory" AutomationProperties.Name="批量移动到分类"/>
                <Separator/>
                <MenuItem Header="切换排序(_O)" InputGestureText="Ctrl+Shift+O" Click="OnToggleSort" AutomationProperties.Name="切换排序模式"/>
                <MenuItem Header="导出TXT(_X)" InputGestureText="Ctrl+Shift+X" Click="OnExportTxt" AutomationProperties.Name="导出为文本文件"/>
            </MenuItem>
            <MenuItem Header="视图(_V)" AutomationProperties.Name="视图菜单">
                <MenuItem Header="网址收藏(_1)" InputGestureText="Ctrl+1" Click="OnSwitchUrl" AutomationProperties.Name="切换到网址收藏"/>
                <MenuItem Header="记事本(_2)" InputGestureText="Ctrl+2" Click="OnSwitchSnippet" AutomationProperties.Name="切换到记事本"/>
                <MenuItem Header="密码收藏(_3)" InputGestureText="Ctrl+3" Click="OnSwitchPassword" AutomationProperties.Name="切换到密码收藏"/>
                <MenuItem Header="日记(_4)" InputGestureText="Ctrl+4" Click="OnSwitchNote" AutomationProperties.Name="切换到日记"/>
                <MenuItem Header="证件保存(_5)" InputGestureText="Ctrl+5" Click="OnSwitchIdDocument" AutomationProperties.Name="切换到证件保存"/>
                <MenuItem Header="记账(_6)" InputGestureText="Ctrl+6" Click="OnSwitchAccounting" AutomationProperties.Name="切换到记账"/>
                <Separator/>
                <MenuItem Header="切换焦点区域(_G)" InputGestureText="F6" Click="OnCycleFocus" AutomationProperties.Name="在分类树/列表/详情之间切换焦点"/>
            </MenuItem>
            <MenuItem Header="操作(_O)" AutomationProperties.Name="操作菜单">
                <MenuItem Header="打开网址(_O)" InputGestureText="Enter" Click="OnOpenUrl" AutomationProperties.Name="用默认浏览器打开网址"/>
                <MenuItem Header="复制网址(_C)" InputGestureText="Ctrl+Enter" Click="OnCopyUrl" AutomationProperties.Name="复制网址到剪贴板"/>
                <Separator/>
                <MenuItem Header="复制内容(_W)" Click="OnCopySnippet" AutomationProperties.Name="复制笔记内容到剪贴板"/>
                <MenuItem Header="插入模板(_I)" InputGestureText="Ctrl+Shift+I" Click="OnInsertTemplate" AutomationProperties.Name="选择模板复制到剪贴板"/>
                <MenuItem Header="按月浏览日记(_M)" InputGestureText="Ctrl+Shift+M" Click="OnBrowseByMonth" AutomationProperties.Name="按月份浏览日记"/>
                <Separator/>
                <MenuItem Header="复制密码(_P)" InputGestureText="Ctrl+Shift+C" Click="OnCopyPassword" AutomationProperties.Name="复制密码"/>
                <MenuItem Header="复制用户名(_U)" InputGestureText="Ctrl+Shift+B" Click="OnCopyUserName" AutomationProperties.Name="复制用户名"/>
                <MenuItem Header="复制手机号(_H)" InputGestureText="Ctrl+Shift+P" Click="OnCopyPhone" AutomationProperties.Name="复制手机号"/>
                <MenuItem Header="复制动态验证码(_T)" InputGestureText="Ctrl+Shift+T" Click="OnCopyTotp" AutomationProperties.Name="复制 TOTP 动态验证码"/>
                <MenuItem Header="字段选择器(_W)" InputGestureText="Ctrl+Shift+V" Click="OnFieldSelector" AutomationProperties.Name="打开字段选择器"/>
                <Separator/>
                <MenuItem Header="锁定密码库(_L)" InputGestureText="Ctrl+Shift+L" Click="OnLock" AutomationProperties.Name="锁定密码库"/>
                <MenuItem Header="密码生成器(_G)" InputGestureText="F5" Click="OnPasswordGenerator" AutomationProperties.Name="打开密码生成器"/>
            </MenuItem>
            <MenuItem Header="工具(_T)" AutomationProperties.Name="工具菜单">
                <MenuItem Header="重复检测(_D)" Click="OnDuplicateCheck" AutomationProperties.Name="检测重复网址和密码"/>
                <MenuItem Header="网址健康检查(_H)" Click="OnUrlHealthCheck" AutomationProperties.Name="检查网址可访问性"/>
                <MenuItem Header="分类管理(_C)" Click="OnCategoryManager" AutomationProperties.Name="管理分类和标签"/>
                <MenuItem Header="查看审计日志(_A)" Click="OnViewAuditLog" AutomationProperties.Name="查看操作审计日志"/>
                <MenuItem Header="快捷键设置(_K)" Click="OnShortcutConfig" AutomationProperties.Name="自定义快捷键"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)" AutomationProperties.Name="帮助菜单">
                <MenuItem Header="快捷键说明(_K)" Click="OnHelpShortcuts" AutomationProperties.Name="快捷键说明"/>
                <MenuItem Header="关于(_A)" Click="OnAbout" AutomationProperties.Name="关于本程序"/>
            </MenuItem>
        </Menu>

        <!-- 模块切换标签：网址收藏 / 记事本 / 密码收藏 / 日记 / 证件保存 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#FFF2F2F2" Margin="0,0,0,3">
            <RadioButton x:Name="urlModuleRadio" Content="网址收藏" GroupName="Module"
                         IsChecked="True" Margin="10,5" Padding="6,2"
                         Checked="OnUrlModuleChecked"
                         AutomationProperties.Name="网址收藏模块，按 Ctrl+1 切换"/>
            <RadioButton x:Name="snippetModuleRadio" Content="记事本" GroupName="Module"
                         Margin="10,5" Padding="6,2"
                         Checked="OnSnippetModuleChecked"
                         AutomationProperties.Name="记事本模块，按 Ctrl+2 切换"/>
            <RadioButton x:Name="passwordModuleRadio" Content="密码收藏" GroupName="Module"
                         Margin="10,5" Padding="6,2"
                         Checked="OnPasswordModuleChecked"
                         AutomationProperties.Name="密码收藏模块，按 Ctrl+3 切换"/>
            <RadioButton x:Name="noteModuleRadio" Content="日记" GroupName="Module"
                         Margin="10,5" Padding="6,2"
                         Checked="OnNoteModuleChecked"
                         AutomationProperties.Name="日记模块，按 Ctrl+4 切换"/>
            <RadioButton x:Name="idDocumentModuleRadio" Content="证件保存" GroupName="Module"
                         Margin="10,5" Padding="6,2"
                         Checked="OnIdDocumentModuleChecked"
                         AutomationProperties.Name="证件保存模块，按 Ctrl+5 切换"/>
            <RadioButton x:Name="accountingModuleRadio" Content="记账" GroupName="Module"
                         Margin="10,5" Padding="6,2"
                         Checked="OnAccountingModuleChecked"
                         AutomationProperties.Name="记账模块，按 Ctrl+6 切换"/>
        </StackPanel>

        <!-- 底部状态栏 -->
        <Grid DockPanel.Dock="Bottom" Height="26" Background="#FFF2F2F2"
              AutomationProperties.Name="状态栏">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="statusPositionText"
                       Text="就绪" VerticalAlignment="Center" Margin="8,0"
                       AutomationProperties.Name="当前位置"/>
            <TextBlock Grid.Column="1" x:Name="statusHintText"
                       Text="Ctrl+1 网址 Ctrl+2 记事本 Ctrl+3 密码 Ctrl+4 日记 Ctrl+5 证件 Ctrl+6 记账 F6 切换区域"
                       VerticalAlignment="Center" Margin="12,0"
                       AutomationProperties.Name="快捷键提示"/>
            <TextBlock Grid.Column="2" x:Name="statusMessageText"
                       Text="" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="8,0"
                       AutomationProperties.Name="操作结果播报"/>
        </Grid>

        <!-- 主内容区：左分类树 | 右(搜索+列表+详情) -->
        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧分类树 -->
            <TreeView x:Name="categoryTree" Grid.Column="0"
                      AutomationProperties.Name="分类树"
                      SelectedItemChanged="OnCategorySelected"
                      KeyDown="CategoryTree_KeyDown"/>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          AutomationProperties.Name="分类树与列表的分隔条"/>

            <!-- 右侧：搜索框 + 列表 + 详情 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <!-- 搜索框 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <Label Content="搜索(_S):" Target="{Binding ElementName=searchBox}"
                           AutomationProperties.Name="搜索标签"/>
                    <TextBox x:Name="searchBox" Width="320"
                             TextChanged="OnSearchChanged"
                             AutomationProperties.Name="搜索框，输入关键词过滤列表"/>
                    <Button x:Name="clearSearchButton" Content="清除(_C)" Margin="8,0,0,0"
                            Click="OnClearSearch"
                            AutomationProperties.Name="清除搜索内容"/>
                </StackPanel>

                <!-- 列表区（网址/记事本/密码/日记/证件/解锁面板） -->
                <Grid Grid.Row="1">
                    <ListBox x:Name="urlListBox"
                             SelectionMode="Extended"
                             SelectionChanged="OnUrlSelectionChanged"
                             MouseDoubleClick="OnUrlDoubleClick"
                             AutomationProperties.Name="网址列表"/>
                    <ListBox x:Name="snippetListBox" Visibility="Collapsed"
                             SelectionMode="Extended"
                             SelectionChanged="OnSnippetSelectionChanged"
                             MouseDoubleClick="OnSnippetDoubleClick"
                             AutomationProperties.Name="笔记列表"/>
                    <ListBox x:Name="passwordListBox" Visibility="Collapsed"
                             SelectionMode="Extended"
                             SelectionChanged="OnPasswordSelectionChanged"
                             AutomationProperties.Name="密码列表"/>
                    <ListBox x:Name="noteListBox" Visibility="Collapsed"
                             SelectionMode="Extended"
                             SelectionChanged="OnNoteSelectionChanged"
                             MouseDoubleClick="OnNoteDoubleClick"
                             AutomationProperties.Name="日记列表"/>
                    <ListBox x:Name="idDocumentListBox" Visibility="Collapsed"
                             SelectionMode="Extended"
                             SelectionChanged="OnIdDocumentSelectionChanged"
                             MouseDoubleClick="OnIdDocumentDoubleClick"
                             AutomationProperties.Name="证件列表"/>
                    <ListBox x:Name="accountingListBox" Visibility="Collapsed"
                             SelectionMode="Extended"
                             SelectionChanged="OnAccountingSelectionChanged"
                             MouseDoubleClick="OnAccountingDoubleClick"
                             AutomationProperties.Name="记账列表"/>
                    <Border x:Name="unlockPanel" Visibility="Collapsed"
                            BorderBrush="#FFB0B0B0" BorderThickness="1" Background="#FFFAFAFA"
                            Padding="20"
                            AutomationProperties.Name="主密码解锁面板">
                        <StackPanel VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock x:Name="unlockPromptText" Text="请输入主密码："
                                       FontWeight="Bold" Margin="0,0,0,10"
                                       AutomationProperties.Name="主密码提示"/>
                            <PasswordBox x:Name="masterPasswordBox" Margin="0,0,0,8"
                                         KeyDown="MasterPasswordBox_KeyDown"
                                         AutomationProperties.Name="主密码输入框"/>
                            <PasswordBox x:Name="masterPasswordConfirmBox" Margin="0,0,0,8" Visibility="Collapsed"
                                         KeyDown="MasterPasswordBox_KeyDown"
                                         AutomationProperties.Name="确认主密码输入框"/>
                            <Button x:Name="unlockButton" Content="解锁(_U)" HorizontalAlignment="Left"
                                    Padding="16,4" Click="OnUnlockButtonClick"
                                    AutomationProperties.Name="解锁或设置主密码按钮"/>
                            <TextBlock x:Name="unlockHintText"
                                       Text="输入主密码后按回车解锁"
                                       Opacity="0.7" Margin="0,10,0,0" TextWrapping="Wrap"
                                       AutomationProperties.Name="解锁说明"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              AutomationProperties.Name="列表与详情的分隔条"/>

                <!-- 详情区 -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                              AutomationProperties.Name="详情区">
                    <TextBlock x:Name="detailText" TextWrapping="Wrap" Focusable="True"
                               Padding="4"
                               AutomationProperties.Name="详情内容"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 配置文件
  将全局包缓存目录设置到项目内的 .nuget/packages/，
  实现缓存与项目同目录，便于管理和迁移。
-->
<configuration>
  <config>
    <!-- NuGet 包缓存目录（项目内） -->
    <add key="globalPackagesFolder" value="./.nuget/packages" />
    <!-- HTTP 请求缓存目录（项目内） -->
    <add key="httpCachePath" value="./.nuget/v3-cache" />
  </config>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
